# fantuan-kernel — make configuration (tracked defaults).
#
# These knobs steer *orchestration*: which architecture, which profile to write
# before building, what to pass on to the scripts. The kernel's own
# configuration (the CONFIG_* symbols) is a different file — `.config`, written
# by tools/kconfig.py — see `make config` and docs/BUILD.md §3.1.
#
# Do not edit this file for your own checkout: put overrides in
# config.local.mk next to it (gitignored, read after this one):
#
#     ARCH = riscv64
#     RUN_ARGS = --net
#
# A one-off override works too, and beats both files:
#
#     make build ARCH=aarch64
#     make run RUN_ARGS="--graphics --vga std"
#
# Plain environment variables (FANTUAN_OFFLINE, FANTUAN_BUILD_BASH, …) are
# passed straight through to the scripts — `FANTUAN_OFFLINE=1 make build`.

# Target architecture for `make build` / `make run`:
#   x86_64  UEFI, the product (default)
#   riscv64 RISC-V under OpenSBI (QEMU virt)
#   aarch64 ARM64 direct-FDT boot (QEMU virt)
#   i686    32-bit BIOS (tools/build-i686.sh, tools/run-bios.sh --arch i686)
ARCH ?= x86_64

# Profile to write into .config before a build (empty = leave it alone; with no
# .config at all the scripts materialize `minimal`):
#   minimal | rescue | net | tls | desktop | hypervisor | imager | all
PROFILE ?=

# Extra arguments appended to the script each target calls. Examples:
#   BUILD_ARGS = --features kconfig-net
#   RUN_ARGS   = --disk --two-fs
#   SMOKE_ARGS = (nothing today; kept so wrapper scripts stay uniform)
BUILD_ARGS ?=
RUN_ARGS ?=
SMOKE_ARGS ?=

# `make smoke` runs these suites (space separated, without the `smoke-` prefix
# and the `.sh`). They need no disk fixtures and no network, so they are the
# ones a contributor can run all day.
SMOKE_SET ?= config gpl apps posix

# `make test-matrix` runs these across the architectures (each is slow and
# needs QEMU + OVMF + OpenSBI).
MATRIX_SET ?= smoke bios riscv aarch64 iso
